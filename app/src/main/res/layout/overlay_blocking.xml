<?xml version="1.0" encoding="utf-8"?>
<!-- Overlay 2: Bloqueo interactivo (2do cartel) — rojo CogniPilot -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#EDEF4D4D"
    android:padding="20dp"
    android:elevation="32dp">

    <TextView
        android:id="@+id/tvBlockingTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🚫 ESCANEO QR DETECTADO"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/barlow_condensed_bold"
        android:letterSpacing="0.04"
        android:textColor="@color/cp_text_strong"
        android:gravity="center"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/tvBlockingMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Se detectaron botones de escaneo en pantalla."
        android:textSize="13sp"
        android:textColor="@color/cp_text_strong"
        android:lineSpacingExtra="4dp"
        android:paddingBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="✅ Aceptar"
            android:textAllCaps="false"
            android:fontFamily="@font/barlow_condensed_bold"
            android:letterSpacing="0.03"
            android:backgroundTint="@color/cp_success"
            android:textColor="@color/cp_accent_text"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnContinue"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="⚠ Continuar"
            android:textAllCaps="false"
            android:fontFamily="@font/barlow_condensed_bold"
            android:letterSpacing="0.03"
            android:backgroundTint="@color/cp_bg"
            android:textColor="@color/cp_text" />

    </LinearLayout>

</LinearLayout>
