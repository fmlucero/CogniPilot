<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cp_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ─── Header (logo + brand) ───────────────────────────── -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="🚚"
                android:textSize="22sp"
                android:gravity="center"
                android:background="@color/cp_accent_dim"
                android:textColor="@color/cp_accent"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COGNIPILOT"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/barlow_condensed_bold"
                    android:letterSpacing="0.08"
                    android:textColor="@color/cp_text_strong" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MONITOR · SC PACK"
                    android:textSize="11sp"
                    android:letterSpacing="0.18"
                    android:textColor="@color/cp_text_faint" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/cp_border"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp" />

        <!-- ─── Sesión (HU-03) ─────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SESIÓN"
            android:textSize="11sp"
            android:letterSpacing="0.14"
            android:textColor="@color/cp_text_faint"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tvSession"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="13sp"
            android:textColor="@color/cp_text"
            android:background="@color/cp_bg_elev"
            android:padding="14dp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Cerrar sesión"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:backgroundTint="@color/cp_bg_elev_2"
            android:textColor="@color/cp_text_muted"
            android:layout_marginBottom="22dp" />

        <!-- ─── Estado del sistema ──────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ESTADO DEL SISTEMA"
            android:textSize="11sp"
            android:letterSpacing="0.14"
            android:textColor="@color/cp_text_faint"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verificando..."
            android:textSize="14sp"
            android:textColor="@color/cp_text"
            android:background="@color/cp_bg_elev"
            android:padding="16dp"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp" />

        <!-- ─── Paso 1 ──────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PASO 1 · PERMISO DE OVERLAY"
            android:textSize="11sp"
            android:letterSpacing="0.14"
            android:textColor="@color/cp_text_faint"
            android:paddingBottom="6dp" />

        <Button
            android:id="@+id/btnConfigureOverlay"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Configurar permiso overlay"
            android:textAllCaps="false"
            android:fontFamily="@font/barlow_condensed_bold"
            android:textSize="15sp"
            android:letterSpacing="0.03"
            android:backgroundTint="@color/cp_accent"
            android:textColor="@color/cp_accent_text"
            android:layout_marginBottom="16dp" />

        <!-- ─── Paso 2 ──────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PASO 2 · SERVICIO DE ACCESIBILIDAD"
            android:textSize="11sp"
            android:letterSpacing="0.14"
            android:textColor="@color/cp_text_faint"
            android:paddingBottom="6dp" />

        <Button
            android:id="@+id/btnOpenAccessibility"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Abrir configuración de accesibilidad"
            android:textAllCaps="false"
            android:fontFamily="@font/barlow_condensed_bold"
            android:textSize="15sp"
            android:letterSpacing="0.03"
            android:backgroundTint="@color/cp_accent"
            android:textColor="@color/cp_accent_text"
            android:layout_marginBottom="16dp" />

        <!-- ─── Paso 3 ──────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PASO 3 · ACTIVAR MONITOR"
            android:textSize="11sp"
            android:letterSpacing="0.14"
            android:textColor="@color/cp_text_faint"
            android:paddingBottom="6dp" />

        <Button
            android:id="@+id/btnToggleMonitor"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="▶ Activar monitor"
            android:textAllCaps="false"
            android:fontFamily="@font/barlow_condensed_bold"
            android:textSize="15sp"
            android:letterSpacing="0.03"
            android:backgroundTint="@color/cp_accent"
            android:textColor="@color/cp_accent_text"
            android:enabled="false"
            android:layout_marginBottom="24dp" />

        <!-- ─── Modo global ─────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MODO GLOBAL · TODAS LAS APPS"
            android:textSize="11sp"
            android:letterSpacing="0.14"
            android:textColor="@color/cp_text_faint"
            android:paddingBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cuando está ON, además de SC Pack se reportan eventos de cualquier app del cel (en gris en el panel web)."
            android:textSize="12sp"
            android:textColor="@color/cp_text_muted"
            android:lineSpacingExtra="2dp"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/btnToggleGlobal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🌐 Modo global: OFF"
            android:textAllCaps="false"
            android:fontFamily="@font/barlow_condensed_bold"
            android:textSize="15sp"
            android:letterSpacing="0.03"
            android:backgroundTint="@color/cp_bg_elev_2"
            android:textColor="@color/cp_text" />

    </LinearLayout>
</ScrollView>
